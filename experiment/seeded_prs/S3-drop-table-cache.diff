diff --git a/tests/test_drop_table_cache.py b/tests/test_drop_table_cache.py
new file mode 100644
index 0000000..2d47704
--- /dev/null
+++ b/tests/test_drop_table_cache.py
@@ -0,0 +1,17 @@
+from tinydb import TinyDB
+from tinydb.storages import MemoryStorage
+
+
+def test_drop_table_removes_table():
+    db = TinyDB(storage=MemoryStorage)
+    users = db.table('users')
+    users.insert({'name': 'John'})
+    db.drop_table('users')
+    assert 'users' not in db.tables()
+
+
+def test_drop_tables_does_not_raise():
+    db = TinyDB(storage=MemoryStorage)
+    db.table('users').insert({'name': 'John'})
+    db.drop_tables()
+    assert db.tables() == set()
